@model IEnumerable<MobileShopBilling.Application.DTOs.UserDto>
@{ ViewData["Title"] = "Users"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-person-gear me-2"></i>Shop Users</h4>
    <a href="/Users/Create" class="btn btn-primary"><i class="bi bi-plus"></i> Add User</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td>@u.Email</td>
                        <td>@(u.PhoneNumber ?? "-")</td>
                        <td>
                            @if (u.Role == "ShopAdmin") { <span class="badge bg-primary">Admin</span> }
                            else { <span class="badge bg-secondary">Staff</span> }
                        </td>
                        <td>
                            @if (u.IsActive) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-danger">Inactive</span> }
                        </td>
                        <td>
                            <a href="/Users/Edit/@u.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            @if (u.IsActive)
                            {
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Deactivate?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-person-x"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="6" class="text-center text-muted py-3">No users found</td></tr> }
            </tbody>
        </table>
    </div>
</div>
