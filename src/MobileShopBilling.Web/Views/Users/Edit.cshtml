@model MobileShopBilling.Application.DTOs.UpdateUserDto
@{ ViewData["Title"] = "Edit User"; }

<h4 class="mb-4"><i class="bi bi-pencil me-2"></i>Edit User</h4>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Full Name *</label>
                <input asp-for="FullName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Phone</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Role *</label>
                <select asp-for="Role" class="form-select" required>
                    <option value="ShopAdmin">Admin</option>
                    <option value="Staff">Staff</option>
                </select>
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
                <a href="/Users" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
