@model MobileShopBilling.Application.DTOs.DashboardDto
@{ ViewData["Title"] = "Dashboard"; }

<h4 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title opacity-75">Today's Revenue</h6>
                        <h3 class="mb-0">@Model.TodayRevenue.ToString("N2")</h3>
                    </div>
                    <i class="bi bi-currency-rupee" style="font-size:2.5rem;opacity:0.5;"></i>
                </div>
                <small>@Model.TodayInvoices invoices today</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title opacity-75">Total Revenue</h6>
                        <h3 class="mb-0">@Model.TotalRevenue.ToString("N2")</h3>
                    </div>
                    <i class="bi bi-graph-up-arrow" style="font-size:2.5rem;opacity:0.5;"></i>
                </div>
                <small>@Model.TotalInvoices total invoices</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title opacity-75">Products</h6>
                        <h3 class="mb-0">@Model.TotalProducts</h3>
                    </div>
                    <i class="bi bi-box-seam" style="font-size:2.5rem;opacity:0.5;"></i>
                </div>
                <small>@Model.TotalCustomers customers</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title opacity-75">Low Stock</h6>
                        <h3 class="mb-0">@Model.LowStockProducts</h3>
                    </div>
                    <i class="bi bi-exclamation-triangle" style="font-size:2.5rem;opacity:0.5;"></i>
                </div>
                <small><a href="/Products/LowStock" class="text-dark">View details</a></small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Recent Invoices</h6>
                <a href="/Billing" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Invoice #</th><th>Customer</th><th>Amount</th><th>Date</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.RecentInvoices)
                        {
                            <tr>
                                <td>@inv.InvoiceNumber</td>
                                <td>@(inv.CustomerName ?? "Walk-in")</td>
                                <td>@inv.TotalAmount.ToString("N2")</td>
                                <td>@inv.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                            </tr>
                        }
                        @if (!Model.RecentInvoices.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No invoices yet</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0">Top Products (30 days)</h6>
            </div>
            <div class="card-body">
                @foreach (var product in Model.TopProducts)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <strong>@product.ProductName</strong>
                            <br/><small class="text-muted">@product.QuantitySold units sold</small>
                        </div>
                        <span class="badge bg-success">@product.Revenue.ToString("N0")</span>
                    </div>
                }
                @if (!Model.TopProducts.Any())
                {
                    <p class="text-muted text-center">No sales data yet</p>
                }
            </div>
        </div>
    </div>
</div>
