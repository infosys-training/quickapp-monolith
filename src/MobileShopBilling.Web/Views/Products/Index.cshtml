@model IEnumerable<MobileShopBilling.Application.DTOs.ProductDto>
@{ ViewData["Title"] = "Products"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-box-seam me-2"></i>Products</h4>
    <a href="/Products/Create" class="btn btn-primary"><i class="bi bi-plus"></i> Add Product</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th><th>Brand</th><th>IMEI</th><th>Barcode</th>
                    <th>Purchase Price</th><th>Selling Price</th><th>Stock</th><th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.IsLowStock ? "table-warning" : "")">
                        <td><strong>@p.Name</strong></td>
                        <td>@(p.Brand ?? "-")</td>
                        <td>@(p.IMEI ?? "-")</td>
                        <td>@(p.Barcode ?? "-")</td>
                        <td>@p.PurchasePrice.ToString("N2")</td>
                        <td>@p.SellingPrice.ToString("N2")</td>
                        <td>
                            @p.StockQuantity
                            @if (p.IsLowStock)
                            { <i class="bi bi-exclamation-triangle text-warning" title="Low Stock"></i> }
                        </td>
                        <td>
                            @if (p.IsActive) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>
                            <a href="/Products/Edit/@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this product?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-3">No products found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
