@model MobileShopBilling.Application.DTOs.SuperAdminDashboardDto
@{ ViewData["Title"] = "Super Admin Dashboard"; }

<h4 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>System Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <h6 class="opacity-75">Total Shops</h6>
                <h3>@Model.TotalShops</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <h6 class="opacity-75">Active Shops</h6>
                <h3>@Model.ActiveShops</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-danger text-white">
            <div class="card-body">
                <h6 class="opacity-75">Inactive Shops</h6>
                <h3>@Model.InactiveShops</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <h6 class="opacity-75">Total Users</h6>
                <h3>@Model.TotalUsers</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Recent Shops</h6>
        <a href="/SuperAdmin/CreateShop" class="btn btn-sm btn-primary"><i class="bi bi-plus"></i> New Shop</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Shop Name</th><th>Owner</th><th>Email</th><th>Status</th><th>Created</th></tr>
            </thead>
            <tbody>
                @foreach (var shop in Model.RecentShops)
                {
                    <tr>
                        <td>@shop.ShopName</td>
                        <td>@shop.OwnerName</td>
                        <td>@shop.Email</td>
                        <td>
                            @if (shop.IsActive)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-danger">Inactive</span> }
                        </td>
                        <td>@shop.CreatedAt.ToString("dd-MMM-yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
