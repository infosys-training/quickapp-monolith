@model IEnumerable<MobileShopBilling.Application.DTOs.TenantDto>
@{ ViewData["Title"] = "All Shops"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-shop me-2"></i>All Shops</h4>
    <a href="/SuperAdmin/CreateShop" class="btn btn-primary"><i class="bi bi-plus"></i> Create Shop</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Shop Name</th><th>Owner</th><th>Email</th><th>Phone</th><th>GST</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var shop in Model)
                {
                    <tr>
                        <td><strong>@shop.ShopName</strong></td>
                        <td>@shop.OwnerName</td>
                        <td>@shop.Email</td>
                        <td>@shop.Phone</td>
                        <td>@(shop.GstNumber ?? "-")</td>
                        <td>
                            @if (shop.IsActive)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-danger">Inactive</span> }
                        </td>
                        <td>
                            <form asp-action="ToggleStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@shop.Id" />
                                <button type="submit" class="btn btn-sm @(shop.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(shop.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
