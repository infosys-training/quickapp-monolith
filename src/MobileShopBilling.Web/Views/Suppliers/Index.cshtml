@model IEnumerable<MobileShopBilling.Application.DTOs.SupplierDto>
@{ ViewData["Title"] = "Suppliers"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-truck me-2"></i>Suppliers</h4>
    <a href="/Suppliers/Create" class="btn btn-primary"><i class="bi bi-plus"></i> Add Supplier</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Contact</th><th>Email</th><th>Phone</th><th>GST</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><strong>@s.Name</strong></td>
                        <td>@(s.ContactPerson ?? "-")</td>
                        <td>@(s.Email ?? "-")</td>
                        <td>@s.Phone</td>
                        <td>@(s.GstNumber ?? "-")</td>
                        <td>
                            <a href="/Suppliers/Edit/@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="6" class="text-center text-muted py-3">No suppliers found</td></tr> }
            </tbody>
        </table>
    </div>
</div>
