@model IEnumerable<MobileShopBilling.Application.DTOs.CustomerDto>
@{ ViewData["Title"] = "Customers"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-people me-2"></i>Customers</h4>
    <a href="/Customers/Create" class="btn btn-primary"><i class="bi bi-plus"></i> Add Customer</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>GST</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Name</strong></td>
                        <td>@(c.Email ?? "-")</td>
                        <td>@c.Phone</td>
                        <td>@(c.Address ?? "-")</td>
                        <td>@(c.GstNumber ?? "-")</td>
                        <td>
                            <a href="/Customers/Edit/@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="6" class="text-center text-muted py-3">No customers found</td></tr> }
            </tbody>
        </table>
    </div>
</div>
