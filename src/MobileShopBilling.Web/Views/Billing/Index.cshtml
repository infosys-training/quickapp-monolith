@model IEnumerable<MobileShopBilling.Application.DTOs.InvoiceDto>
@{ ViewData["Title"] = "Invoices"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-receipt me-2"></i>Invoices</h4>
    <a href="/Billing/Create" class="btn btn-primary"><i class="bi bi-plus"></i> New Invoice</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Invoice #</th><th>Date</th><th>Customer</th><th>Amount</th><th>Payment</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var inv in Model)
                {
                    <tr>
                        <td><strong>@inv.InvoiceNumber</strong></td>
                        <td>@inv.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                        <td>@(inv.CustomerName ?? "Walk-in")</td>
                        <td>@inv.TotalAmount.ToString("N2")</td>
                        <td>@inv.PaymentMode</td>
                        <td>
                            @if (inv.Status == MobileShopBilling.Domain.Enums.InvoiceStatus.Completed)
                            { <span class="badge bg-success">Completed</span> }
                            else if (inv.Status == MobileShopBilling.Domain.Enums.InvoiceStatus.Cancelled)
                            { <span class="badge bg-danger">Cancelled</span> }
                            else
                            { <span class="badge bg-warning">Draft</span> }
                        </td>
                        <td>
                            <a href="/Billing/Details/@inv.Id" class="btn btn-sm btn-outline-info" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="/Billing/DownloadPdf/@inv.Id" class="btn btn-sm btn-outline-success" title="PDF">
                                <i class="bi bi-file-pdf"></i>
                            </a>
                            @if (inv.Status == MobileShopBilling.Domain.Enums.InvoiceStatus.Completed)
                            {
                                <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Cancel this invoice?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@inv.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="7" class="text-center text-muted py-3">No invoices found</td></tr> }
            </tbody>
        </table>
    </div>
</div>
