@model MobileShopBilling.Application.DTOs.UpdateTaxConfigurationDto
@{ ViewData["Title"] = "Edit Tax Configuration"; }

<h4 class="mb-4"><i class="bi bi-pencil me-2"></i>Edit Tax Configuration</h4>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Tax Name *</label>
                <input asp-for="TaxName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Rate (%) *</label>
                <input asp-for="Rate" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsDefault" class="form-check-input" />
                <label class="form-check-label">Set as default tax</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update</button>
                <a href="/TaxConfig" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
