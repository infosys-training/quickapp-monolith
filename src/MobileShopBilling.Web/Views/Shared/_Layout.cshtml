@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mobile Shop Billing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark text-white" id="sidebar" style="min-width:250px;max-width:250px;min-height:100vh;">
            <div class="p-3 border-bottom border-secondary">
                <h5 class="mb-0"><i class="bi bi-phone"></i> Mobile Shop</h5>
                <small class="text-muted">Billing System</small>
            </div>
            <nav class="p-2">
                @if (isSuperAdmin)
                {
                    <a href="/SuperAdmin" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                    <a href="/SuperAdmin/Shops" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-shop me-2"></i>Shops
                    </a>
                    <a href="/SuperAdmin/CreateShop" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-plus-circle me-2"></i>Create Shop
                    </a>
                }
                else
                {
                    <a href="/" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                    <a href="/Billing" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-receipt me-2"></i>Billing
                    </a>
                    <hr class="border-secondary my-2" />
                    <small class="text-muted px-3">MASTERS</small>
                    <a href="/Products" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-box-seam me-2"></i>Products
                    </a>
                    <a href="/Customers" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-people me-2"></i>Customers
                    </a>
                    <a href="/Suppliers" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-truck me-2"></i>Suppliers
                    </a>
                    <a href="/TaxConfig" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-percent me-2"></i>Tax/GST Config
                    </a>
                    <hr class="border-secondary my-2" />
                    <a href="/Reports" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-bar-chart me-2"></i>Reports
                    </a>
                    @if (User.IsInRole("ShopAdmin"))
                    {
                        <a href="/Users" class="nav-link text-white py-2 px-3 rounded mb-1 sidebar-link">
                            <i class="bi bi-person-gear me-2"></i>Users
                        </a>
                    }
                    <a href="/Products/LowStock" class="nav-link text-warning py-2 px-3 rounded mb-1 sidebar-link">
                        <i class="bi bi-exclamation-triangle me-2"></i>Low Stock
                    </a>
                }
            </nav>
        </div>

        <!-- Page Content -->
        <div id="page-content" class="w-100">
            <nav class="navbar navbar-expand navbar-light bg-white shadow-sm px-3">
                <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <div class="ms-auto d-flex align-items-center">
                    <span class="me-3 text-muted">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <span class="badge bg-danger ms-1">Super Admin</span>
                        }
                        else if (User.IsInRole("ShopAdmin"))
                        {
                            <span class="badge bg-primary ms-1">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-1">Staff</span>
                        }
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                </div>
            </nav>

            <div class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        @RenderBody()
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', function() {
        var sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('d-none');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
