@model IEnumerable<MobileShopBilling.Application.DTOs.SalesReportDto>
@{ ViewData["Title"] = "Sales Report"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-graph-up me-2"></i>Sales Report</h4>
    <a href="/Reports/ExportSales?from=@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))&to=@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"
       class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Export Excel</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Date</th><th>Invoices</th><th>Total Amount</th><th>Tax</th><th>Discount</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Date.ToString("dd-MMM-yyyy")</td>
                        <td>@r.InvoiceCount</td>
                        <td>@r.TotalAmount.ToString("N2")</td>
                        <td>@r.TaxAmount.ToString("N2")</td>
                        <td>@r.DiscountAmount.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="5" class="text-center text-muted py-3">No data for this period</td></tr> }
            </tbody>
            @if (Model.Any())
            {
                <tfoot class="table-light">
                    <tr>
                        <td><strong>Total</strong></td>
                        <td><strong>@Model.Sum(r => r.InvoiceCount)</strong></td>
                        <td><strong>@Model.Sum(r => r.TotalAmount).ToString("N2")</strong></td>
                        <td><strong>@Model.Sum(r => r.TaxAmount).ToString("N2")</strong></td>
                        <td><strong>@Model.Sum(r => r.DiscountAmount).ToString("N2")</strong></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
