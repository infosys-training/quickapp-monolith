@model IEnumerable<MobileShopBilling.Application.DTOs.InvoiceDto>
@{ ViewData["Title"] = "Invoice History"; }

<h4 class="mb-4"><i class="bi bi-receipt me-2"></i>Invoice History</h4>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Invoice #</th><th>Date</th><th>Customer</th><th>Amount</th><th>Payment</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var inv in Model)
                {
                    <tr>
                        <td><strong>@inv.InvoiceNumber</strong></td>
                        <td>@inv.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                        <td>@(inv.CustomerName ?? "Walk-in")</td>
                        <td>@inv.TotalAmount.ToString("N2")</td>
                        <td>@inv.PaymentMode</td>
                        <td>
                            @if (inv.Status == MobileShopBilling.Domain.Enums.InvoiceStatus.Completed)
                            { <span class="badge bg-success">Completed</span> }
                            else if (inv.Status == MobileShopBilling.Domain.Enums.InvoiceStatus.Cancelled)
                            { <span class="badge bg-danger">Cancelled</span> }
                            else { <span class="badge bg-warning">Draft</span> }
                        </td>
                        <td>
                            <a href="/Billing/Details/@inv.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a href="/Billing/DownloadPdf/@inv.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-file-pdf"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="7" class="text-center text-muted py-3">No invoices for this period</td></tr> }
            </tbody>
        </table>
    </div>
</div>
