@{ ViewData["Title"] = "Reports"; }

<h4 class="mb-4"><i class="bi bi-bar-chart me-2"></i>Reports</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card stat-card h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-graph-up" style="font-size:2.5rem;color:#0d6efd;"></i>
                <h5 class="mt-3">Sales Report</h5>
                <p class="text-muted">Daily/monthly sales summary</p>
                <a href="/Reports/Sales" class="btn btn-primary">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-box-seam" style="font-size:2.5rem;color:#198754;"></i>
                <h5 class="mt-3">Product Sales</h5>
                <p class="text-muted">Product-wise sales breakdown</p>
                <a href="/Reports/ProductSales" class="btn btn-success">View Report</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card h-100">
            <div class="card-body text-center py-4">
                <i class="bi bi-receipt" style="font-size:2.5rem;color:#6f42c1;"></i>
                <h5 class="mt-3">Invoice History</h5>
                <p class="text-muted">Complete invoice records</p>
                <a href="/Reports/InvoiceHistory" class="btn btn-outline-primary">View Report</a>
            </div>
        </div>
    </div>
</div>
