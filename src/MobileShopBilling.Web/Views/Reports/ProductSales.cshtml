@model IEnumerable<MobileShopBilling.Application.DTOs.ProductSalesReportDto>
@{ ViewData["Title"] = "Product Sales Report"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4><i class="bi bi-box-seam me-2"></i>Product Sales Report</h4>
    <a href="/Reports/ExportProductSales?from=@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))&to=@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"
       class="btn btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Export Excel</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Product</th><th>Brand</th><th>Qty Sold</th><th>Revenue</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.ProductName</strong></td>
                        <td>@(r.Brand ?? "-")</td>
                        <td>@r.QuantitySold</td>
                        <td>@r.Revenue.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="4" class="text-center text-muted py-3">No data for this period</td></tr> }
            </tbody>
        </table>
    </div>
</div>
